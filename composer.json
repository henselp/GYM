{
    "name": "gymfit/app",
    "description": "GYMFIT - Plataforma de gestión de gimnasio",
    "type": "project",
    "autoload": {
        "psr-4": {
            "Gymfit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Gymfit\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "scripts": {
        "test": "phpunit",
        "test-coverage": "phpunit --coverage-html coverage"
    }
}
